# Renext Technologies — Apache rules (requires AllowOverride All for the vhost,
# or copy these into the <VirtualHost> block). Canonical host: https://renexttechnologies.com
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS and non-www (single canonical origin)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://renexttechnologies.com%{REQUEST_URI} [L,R=301]
  # /index.html -> /
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [L,R=301]
</IfModule>

# Never serve repo/internal files from the web root
<FilesMatch "(^\.|\.(zip|sh|md|txt|tsx?|py|bak|log|jsonl)$|^(package|components|tsconfig|vercel)\.json$|^tailwind\.config\.js$|^index\.(backup|standalone)\.html$)">
  Require all denied
</FilesMatch>
<Files "robots.txt">
  Require all granted
</Files>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(jpg|jpeg|png|svg|mp4|webp|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>

ErrorDocument 404 /index.html
